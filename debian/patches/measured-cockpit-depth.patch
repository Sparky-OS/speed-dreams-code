Description: Reduce the measured cockpit wheel pop while keeping a clearly crossed panel
Author: Daniel Ramos (Capitain Jack)
Forwarded: no

--- a/src/modules/graphic/osggraph/Viewer/OsgCamera.cpp
+++ b/src/modules/graphic/osggraph/Viewer/OsgCamera.cpp
@@ -2544,9 +2544,9 @@
     const bool cockpit = selectedList == 0 && selectedCamera < 4;
     double distance = GfParmGetNum(grHandle, GR_SCT_GRAPHIC,
         cockpit ? "stereo cockpit convergence" : "stereo chase convergence",
-        NULL, cockpit ? 1.2 : 2.0);
+        NULL, cockpit ? 0.7 : 2.0);
     if (!(distance > 0.0 && distance < 1.0e6))
-        distance = cockpit ? 1.2 : 2.0;
+        distance = cockpit ? 0.7 : 2.0;
     double separation = GfParmGetNum(grHandle, GR_SCT_GRAPHIC, "stereo eye separation", NULL, 0.065);
     if (!(separation > 0.0 && separation < 1.0))
         separation = 0.065;
--- a/speed-dreams-data/data/config/graph.xml
+++ b/speed-dreams-data/data/config/graph.xml
@@ -15,7 +15,7 @@
 
 <params name="graph" type="param" mode="mw" version="1.19">
 	<section name="Graphic">
-      <attnum name="stereo cockpit convergence" val="1.2"/>
+      <attnum name="stereo cockpit convergence" val="0.7"/>
       <attnum name="stereo chase convergence" val="2.0"/>
       <attnum name="stereo eye separation" val="0.065"/>
       <attnum name="smoke value" val="0"/>
